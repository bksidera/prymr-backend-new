generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id                         String                @id @default(uuid())
  profileIcon                String?
  initialProfileIcon         String?
  userName                   String?               @unique
  firstName                  String?
  lastName                   String?
  role                       String?
  isDefaultCreatorUser       Boolean               @default(false)
  news                       String?
  bio                        String?
  cv                         String?
  email                      String?               @unique
  password                   String?
  profileBackGroundImg       String?
  profileDescription         String?
  profile_is_completed       Boolean               @default(false)
  is_Verified                Boolean               @default(false)
  isDeleted                  Boolean               @default(false)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  stripeCustomerId           String?
  sellerAccountId            String?
  isStripeOnBoardingDone     Boolean               @default(false)
  boards                     Board[]
  BoardImagesCommentLikes    BoardImagesCommentLikes[]
  Collection                 Collection[]
  Reaction                   Reaction[]
  ReactionLikes              ReactionLikes[]
  ReplaceTappable            ReplaceTappable[]
  Tappable                   Tappable[]
  UserCreatorRequests        UserCreatorRequests[]
  followers                  UserFollow[]          @relation("Followers")
  followings                 UserFollow[]          @relation("Followings")
  boardComments              boardComments[]
  newTransactionReceiverUser newTransaction[]      @relation("receiverUser")
  newTransactionSenderUser   newTransaction[]      @relation("senderUser")
  sellerAccount              SellerAccount?        @relation("UserSellerAccount", fields: [sellerAccountId], references: [id])
  stripeCustomer             StripeCustomer?       @relation("UserStripeCustomer", fields: [stripeCustomerId], references: [id])
}

model securityKeys {
  id  String @id @default(uuid())
  key String @unique
}

model UserCreatorRequests {
  id        String   @id @default(uuid())
  userId    String
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reason    String?
  user      user     @relation(fields: [userId], references: [id])
}

model Board {
  id               String           @id @default(uuid())
  userId           String
  postInteractions Int?             @default(0)
  allowComments    Boolean          @default(true)
  collectionId     String?
  isDeleted        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  boardImageScr    String?
  collection       Collection?      @relation(fields: [collectionId], references: [id])
  user             user             @relation(fields: [userId], references: [id])
  BoardImages      BoardImages[]
  Tappable         Tappable[]
  Transaction      Transaction[]
  boardComments    boardComments[]
  newTransaction   newTransaction[]
  saleItems        SaleItem[]
}

model Collection {
  id             String   @id @default(uuid())
  collectionName String
  description    String?
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  Board          Board[]
  user           user     @relation(fields: [userId], references: [id])
}

model BoardImages {
  id             String      @id @default(uuid())
  imageUrl       String
  boardId        String
  title          String?
  description    String?
  isPrivateBoard Boolean     @default(false)
  subTitle       String?
  allowComments  Boolean     @default(false)
  jsonElement    Json?
  jsonComment    Json?
  boardStatus    String      @default("finished")
  isDeleted      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  board                   Board                     @relation(fields: [boardId], references: [id])
  BoardImagesCommentLikes BoardImagesCommentLikes[] @relation("BoardsImagesCommentlikes")
  Reaction                Reaction[]
  tappable                Tappable[]
  boardImagesComments     boardComments[]           @relation("boardImagesComments")
}

model Tappable {
  id                      String            @id @default(uuid())
  ContentImagesLinks      String[]          @default([])
  tappableImage           String?
  left                    String?
  top                     String?
  width                   String?
  height                  String?
  title                   String?
  subTitle                String?
  isSaleItem              Boolean           @default(false)
  price                   BigInt?
  description             String?
  layerName               String?
  actionName              String?
  boardImageId            String
  boardId                 String?
  userId                  String?
  isTappable              Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  inventoryAvailableCount BigInt            @default(0)
  inventoryCount          BigInt            @default(0)
  isDeleted               Boolean           @default(false)
  isInventoryEnabled      Boolean           @default(false)
  isReplace               Boolean           @default(false)
  isVanish                Boolean           @default(false)
  normalizedH             Float?
  normalizedW             Float?
  normalizedX             Float?
  normalizedY             Float?
  switchId                String?
  replaceTappable         ReplaceTappable[]
  board                   Board?            @relation(fields: [boardId], references: [id])
  boardImage              BoardImages       @relation(fields: [boardImageId], references: [id])
  switch                  Switch?           @relation(fields: [switchId], references: [id])
  user                    user?             @relation(fields: [userId], references: [id])
  transactions            Transaction[]
}

model ReplaceTappable {
  id                      String        @id @default(uuid())
  tappableId              String
  title                   String?
  ContentImagesLinks      String[]      @default([])
  layerName               String?
  layerNumber             String?
  isInventoryEnabled      Boolean       @default(false)
  inventoryCount          BigInt        @default(0)
  inventoryAvailableCount BigInt        @default(0)
  userId                  String
  description             String?
  isLockTappable          Boolean       @default(false)
  price                   String?
  top                     String?
  left                    String?
  width                   String?
  height                  String?
  isReplace               Boolean       @default(false)
  isVanish                Boolean       @default(false)
  infoOverlayImage        String[]      @default([])
  actionName              String?
  lockTappableDescription String?
  isDeleted               Boolean       @default(false)
  isInfoOverlay           Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  tappable                Tappable      @relation(fields: [tappableId], references: [id])
  user                    user          @relation(fields: [userId], references: [id])
  Transaction             Transaction[]
  TransactionForVanish    Transaction[] @relation("vanishSwitch")
}

model payment {
  id         String   @id @default(uuid())
  email      String?
  customerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StripeCustomer {
  id           String        @id @default(uuid())
  customerId   String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  users        user[]        @relation("UserStripeCustomer")
}

model Transaction {
  id                  String           @id @default(uuid())
  customerId          String?
  sellerAccountId     String
  customerGuest       Boolean          @default(false)
  tappableId          String?
  switchId            String?
  replaceId           String?
  boardId             String?
  reactionId          String?
  price               BigInt
  stripeTransactionId String           @unique
  title               String
  isInventoryEnabled  Boolean          @default(false)
  inventoryBuyCount   BigInt           @default(0)
  paymentPurpose      String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  board               Board?           @relation(fields: [boardId], references: [id])
  customer            StripeCustomer?  @relation(fields: [customerId], references: [id])
  reaction            Reaction?        @relation(fields: [reactionId], references: [id])
  ReplaceSwitch       ReplaceTappable? @relation(fields: [replaceId], references: [id])
  sellerAccount       SellerAccount    @relation(fields: [sellerAccountId], references: [id])
  switch              ReplaceTappable? @relation("vanishSwitch", fields: [switchId], references: [id])
  tappable            Tappable?        @relation(fields: [tappableId], references: [id])
}

model newTransaction {
  id                  String    @id @default(uuid())
  stripeTransactionId String?   @unique
  customerGuest       Boolean   @default(false)
  customerId          String?
  paymentPurpose      String?
  price               String?
  applicationFee      String?
  stripeFee           String?
  totalAmount         String?
  status              String?
  senderUserId        String?
  receiverUserId      String?
  reactionId          String?
  boardId             String?
  sellerAccountId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  board               Board?    @relation(fields: [boardId], references: [id])
  reaction            Reaction? @relation(fields: [reactionId], references: [id])
  receiverUser        user?     @relation("receiverUser", fields: [receiverUserId], references: [id])
  senderUser          user?     @relation("senderUser", fields: [senderUserId], references: [id])
}

model SellerAccount {
  id              String        @id @default(uuid())
  sellerAccountId String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  verified        Boolean       @default(false)
  transactions    Transaction[]
  users           user[]        @relation("UserSellerAccount")
  saleItems       SaleItem[]
}

model Switch {
  id                String     @id @default(uuid())
  switchAction      String?
  vanishAction      String?
  vanishDescription String?
  isLockTappable    Boolean    @default(false)
  vanishPrice       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  Tappable          Tappable[]
}

model Reaction {
  id                String           @id @default(uuid())
  contentType       String?
  contentText       String?
  top               String?
  left              String?
  contentUrl        String?
  boardImageId      String
  emoji             String?
  width             String?
  height            String?
  backgroundCapture String?
  userId            String?
  parentId          String?
  status            String           @default("confirmed")
  paymentIntentId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  normalizedX       Float?
  normalizedY       Float?
  boardImage        BoardImages      @relation(fields: [boardImageId], references: [id])
  parent            Reaction?        @relation("CommentReplies", fields: [parentId], references: [id])
  replies           Reaction[]       @relation("CommentReplies")
  user              user?            @relation(fields: [userId], references: [id])
  ReactionLikes     ReactionLikes[]
  Transaction       Transaction[]
  newTransaction    newTransaction[]
}

model ReactionLikes {
  id         String    @id @default(uuid())
  reactionId String?
  userId     String?
  reaction   Reaction? @relation(fields: [reactionId], references: [id])
  user       user?     @relation(fields: [userId], references: [id])
}

model UserFollow {
  id         String   @id @default(uuid())
  followerId String
  userId     String
  createdAt  DateTime @default(now())
  follower   user     @relation("Followers", fields: [followerId], references: [id])
  user       user     @relation("Followings", fields: [userId], references: [id])
}

model Image {
  id        String   @id @default(uuid())
  imageUrl  String
  tappables Json
  createdAt DateTime @default(now())
}

model boardComments {
  id                   String                    @id @default(uuid())
  content              String
  userId               String
  boardImageId         String
  boardId              String
  parentBoardCommentId String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  likes                BoardImagesCommentLikes[]
  board                Board                     @relation(fields: [boardId], references: [id])
  BoardImagesComment   BoardImages               @relation("boardImagesComments", fields: [boardImageId], references: [id])
  parentBoardComment   boardComments?            @relation("CommentReplies", fields: [parentBoardCommentId], references: [id])
  replies              boardComments[]           @relation("CommentReplies")
  user                 user                      @relation(fields: [userId], references: [id])
}

model BoardImagesCommentLikes {
  id           String        @id @default(uuid())
  userId       String
  commentId    String
  boardImageId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  Boards       BoardImages   @relation("BoardsImagesCommentlikes", fields: [boardImageId], references: [id])
  comment      boardComments @relation(fields: [commentId], references: [id])
  user         user          @relation(fields: [userId], references: [id])

  @@unique([userId, commentId])
}

model SaleItem {
  id              String        @id @default(uuid())
  boardId         String
  elementId       String
  title           String
  priceCents      Int
  currency        String        @default("usd")
  inventory       Int?
  sellerAccountId String
  stripeProductId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  isDeleted       Boolean       @default(false)
  board           Board         @relation(fields: [boardId], references: [id])
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id])
}
