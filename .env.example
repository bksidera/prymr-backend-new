# Copy to .env and fill in values
# All variables are required unless marked optional

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://...           # Supabase pooled connection string

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=                             # Strong random string (openssl rand -hex 32)

# ── AWS / S3 ─────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESSKEYID=
AWS_SECRETACCESSKEY=
AWS_S3_BUCKETNAME=                      # S3 bucket for file uploads
AWS_S3_BUCKETNAMEFORIMAGES=             # S3 bucket for images (can be same as above)
AWS_CLOUDFRONT_URL=                     # CloudFront distribution URL (no trailing slash)

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...           # Required even when payments are stubbed
STRIPE_WEBHOOK_SECRET=whsec_...        # Stripe webhook signing secret
APPLICATION_FEE=0.05                   # Platform fee as decimal (0.05 = 5%)

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=                      # Live frontend URL (e.g. https://prymr.vercel.app)

# ── Optional ─────────────────────────────────────────────────────────────────
PORT=3000                               # Defaults to 3000 if not set
NODE_ENV=production
